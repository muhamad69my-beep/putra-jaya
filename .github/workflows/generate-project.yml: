name: Generate Android Project
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  generate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - uses: actions/setup-node@v4
        with:
          node-version: 18
      - name: Install tools
        run: |
          sudo apt-get update -y
          sudo apt-get install -y expect
          npm install -g @bubblewrap/cli
      - name: Configure JDK/SDK paths
        run: bubblewrap updateConfig --jdkPath="$JAVA_HOME" --androidSdkPath="$ANDROID_HOME"
      - name: Init project
        run: |
          cat > init.exp << 'EOF'
          set timeout 900
          spawn bubblewrap init --manifest="https://muhamad69my-beep.github.io/putra-jaya/manifest.json" --directory=android
          expect {
            -re {\(Y/n\)} { send "\r"; exp_continue }
            -re {\(y/N\)} { send "y\r"; exp_continue }
            -re "Application name" { send "\r"; exp_continue }
            -re "Short name" { send "\r"; exp_continue }
            -re "Package ID" { send "\r"; exp_continue }
            -re "Full name" { send "PUTRAJAYA\r"; exp_continue }
            -re "Organization" { send "PUTRAJAYA\r"; exp_continue }
            -re "Country code" { send "ID\r"; exp_continue }
            -re "Password" { send "putrajaya123\r"; exp_continue }
            -re "Confirm" { send "putrajaya123\r"; exp_continue }
            eof
          }
          EOF
          expect init.exp
      - name: Commit generated Android project
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add android
          git commit -m "Generate Android TWA project via Bubblewrap" || echo "Nothing to commit"
          git push
